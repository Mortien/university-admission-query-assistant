# SQLite is the zero-configuration demo mode. Switch DB_DRIVER to mysql for MySQL.
DB_DRIVER=sqlite
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change_me
MYSQL_DATABASE=admission_assistant
MATCH_THRESHOLD=0.28
# The model is fetched the first time semantic matching is used.
SENTENCE_MODEL=sentence-transformers/all-MiniLM-L6-v2
PORT=5000
